# Public site URL used for canonical URLs, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://talentele.in

# ---- Enquiry form delivery (server-side only; configure ONE option) ----
# Without either option the form shows a "temporarily unavailable" message
# with phone and email details instead of pretending to succeed.

# Option 1: email via Resend (https://resend.com). The FROM address must be on a domain verified in Resend.
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=info@talentele.in
ENQUIRY_FROM_EMAIL=

# Option 2: POST the enquiry as JSON to a webhook (CRM, Google Apps Script, Zapier, etc.).
ENQUIRY_WEBHOOK_URL=
# Optional shared secret sent in the X-Enquiry-Secret header.
ENQUIRY_WEBHOOK_SECRET=
